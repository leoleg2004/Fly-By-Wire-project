DIRS = broadcastner listener
PROJECT_ROOT = $(abspath ../../../)
BIN_DIR = $(PROJECT_ROOT)/bin/msg/lib
TARGET = $(BIN_DIR)/libdds_communication.a

all: subdirs $(TARGET)

subdirs:
	@for dir in $(DIRS); do $(MAKE) -C $$dir; done

$(TARGET): subdirs
	@mkdir -p $(BIN_DIR)
	@echo ">>> Creating Combined DDS Communication Library..."
	@rm -f $@
	ar rcs $@ $(wildcard */src/output/*.o)

clean:
	@for dir in $(DIRS); do $(MAKE) -C $$dir clean; done
	rm -f $(TARGET)

.PHONY: all subdirs clean
