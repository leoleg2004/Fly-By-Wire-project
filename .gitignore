# ==========================================
# 1. SPAZZATURA DI CMAKE E COMPILATORI
# ==========================================
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
install_manifest.txt
compile_commands.json
CMakeScripts/
# Ignora le cartelle di output della compilazione (i file .o)
**/output/

# ==========================================
# 2. OUTPUT DI COMPILAZIONE (BIN & LIB)
# ==========================================
# Ignora file oggetto e librerie sparse
*.o
*.a
*.so
*.dylib
*.out

# Ignora il contenuto delle cartelle di output reali, ma NON le cartelle stesse
# Usiamo percorsi relativi alla radice per evitare di colpire src/lib/lib
Project_Kernel_Trace/bin/*
Project_Kernel_Trace/build/*

# ECCEZIONI: Cosa vogliamo vedere nonostante siano in bin/
# Permettiamo di vedere le cartelle ma ignoriamo i file al loro interno (tranne eccezioni)
!Project_Kernel_Trace/bin/msg/
!Project_Kernel_Trace/bin/lib/
!Project_Kernel_Trace/bin/app/

# Eccezioni specifiche per file libreria (se vuoi tracciarli)
!Project_Kernel_Trace/bin/lib/*.a
!Project_Kernel_Trace/bin/msg/lib/*.a
!Project_Kernel_Trace/bin/msg/lib/*.so

# ==========================================
# 3. PYTHON E AMBIENTI VIRTUALI
# ==========================================
__pycache__/
*.py[cod]
venv/
.venv/
env/
ambiente_isolato/

# ==========================================
# 4. IDE E CONFIGURAZIONI
# ==========================================
.project
.cproject
.pydevproject
.settings/
.metadata/
.vscode/
.idea/
.history/

# ==========================================
# 5. SICUREZZA PER SORGENTI
# ==========================================
# Assicuriamoci che NIENTE dentro src venga mai ignorato
!Project_Kernel_Trace/src/**
