LIB_NAME  	= communication
LIB_SRC   	= Broadcastner.cpp Listener.cpp

CPPFLAGS = -c -Wall -fpic -m64 -O2 -std=c++0x
LDFLAGS= -m64

CPP= g++

LN= g++
AR=ar

SYSLIBS= -ldl -lm -lpthread -lrt


INCLUDES = -I.

DDS_LIBS =  -lfastcdr -lfastrtps

DIRECTORIES= output.dir 

all: $(DIRECTORIES) $(LIB_NAME) install


#LIB_TARGET= ./lib$(LIB_NAME).so
#LIB_TARGET_Z= ./lib$(LIB_NAME).a

LIB_TARGET= $(SERL_HOME)/DDS/bin/runtime/lib/lib$(LIB_NAME).so
LIB_TARGET_Z= $(SERL_HOME)/DDS/bin/runtime/lib/lib$(LIB_NAME).a


LIB_OBJS    = $(LIB_SRC:%.cpp=output/%.o)

$(LIB_TARGET): $(LIB_OBJS)
	$(LN) $(LDFLAGS) -shared -o $(LIB_TARGET) $(LIB_OBJS) $(DDS_LIBS) $(SYSLIBS)

$(LIB_TARGET_Z): $(LIB_OBJS)
	$(AR) -cru $(LIB_TARGET_Z) $(LIB_OBJS)

$(LIB_NAME): $(LIB_TARGET) $(LIB_TARGET_Z)

output/%.o:%.cpp
	$(CPP) $(CPPFLAGS) $(INCLUDES) $(DEFINES) -c $< -o $@

.PHONY: $(LIB_NAME) 


clean:
	@rm -rf output

install:
#	cp *.hpp $(RUNTIME)/include

%.dir : 
	@echo "Checking directory $*"
	@if [ ! -d $* ]; then \
		echo "Making directory $*"; \
		mkdir -p $* ; \
	fi;
