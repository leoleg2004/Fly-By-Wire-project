LIB_NAME  	= time
LIB_SRC   	= time_library.c

CPPFLAGS = -c -Wall -fpic -m64 -O2 -std=c++0x
LDFLAGS= -m64

CPP= g++

LN= g++
AR=ar

SYSLIBS= -ldl -lm -lpthread -lrt


INCLUDES = -I.

DDS_LIBS =  -lfastcdr -L/home/leonardo/Fast-DDS-3.2.2/build/src/cpp -L/home/leonardo/Fast-CDR-2.2.0/build/src/cpp -Wl,-rpath=/home/leonardo/Fast-DDS-3.2.2/build/src/cpp -Wl,-rpath=/home/leonardo/Fast-CDR-2.2.0/build/src/cpp -lfastdds

DIRECTORIES= output.dir 

all: $(DIRECTORIES) $(LIB_NAME)


LIB_TARGET= ./lib$(LIB_NAME).so
LIB_TARGET_Z= ./lib$(LIB_NAME).a

LIB_OBJS    = $(LIB_SRC:%.c=output/%.o)

$(LIB_TARGET): $(LIB_OBJS)
	$(LN) $(LDFLAGS) -shared -o $(LIB_TARGET) $(LIB_OBJS) $(DDS_LIBS) $(SYSLIBS)

$(LIB_TARGET_Z): $(LIB_OBJS)
	$(AR) -cru $(LIB_TARGET_Z) $(LIB_OBJS)

$(LIB_NAME): $(LIB_TARGET) $(LIB_TARGET_Z)

output/%.o:%.c
	$(CPP) $(CPPFLAGS) $(INCLUDES) $(DEFINES) -c $< -o $@

.PHONY: $(LIB_NAME) 


clean:
	@rm -r output

install:

%.dir : 
	@echo "Checking directory $*"
	@if [ ! -d $* ]; then \
		echo "Making directory $*"; \
		mkdir -p $* ; \
	fi;
