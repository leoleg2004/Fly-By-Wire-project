APP_TARGET    = ThreadAnalysisDDS
LIB_SRC       = ThreadAnalysisDDS.cpp

# ERTS communication libraries
ERTS_LIB_DIR         = ../../lib
ERTS_INCLUDE_DIR     = ../../lib
ERTS_LIBs            = -lcommunication

# Message libraries
IDL_INCLUDE_DIR     = ../../msg/include
IDL_LIB_DIR         = ../../msg/lib
IDL_LIBs            = -lthread_msgs

CPPFLAGS = -c -Wall -fpic -m64 -O2 -std=c++17
LDFLAGS  = -m64

CPP = g++
LN  = g++
AR  = ar

SYSLIBS = -ldl -lm -lpthread -lrt

INCLUDES = -I. -I$(ERTS_INCLUDE_DIR) -I$(IDL_INCLUDE_DIR)

Static_LIBS = -L$(IDL_LIB_DIR)/ $(IDL_LIBs) -L$(ERTS_LIB_DIR)/ $(ERTS_LIBs)

DDS_LIBS = -lfastcdr \
           -L/home/leonardo/Fast-DDS-3.2.2/build/src/cpp \
           -L/home/leonardo/Fast-CDR-2.2.0/build/src/cpp \
           -Wl,-rpath=/home/leonardo/Fast-DDS-3.2.2/build/src/cpp \
           -Wl,-rpath=/home/leonardo/Fast-CDR-2.2.0/build/src/cpp \
           -lfastdds

DIRECTORIES = output.dir

all: $(DIRECTORIES) $(APP_TARGET) clean

APP_OBJS = $(LIB_SRC:%.cpp=output/%.o)

$(APP_TARGET): $(APP_OBJS)
	$(LN) $(LDFLAGS) -o $@ $(APP_OBJS) -Wl,-Bstatic $(Static_LIBS) -Wl,-Bdynamic $(DDS_LIBS) $(SYSLIBS)

output/%.o:%.cpp
	$(CPP) $(CPPFLAGS) $(INCLUDES) $(DEFINES) -c $< -o $@

.PHONY: $(APP_TARGET)

clean:
	@rm -rf output

%.dir :
	@echo "Checking directory $*"
	@if [ ! -d $* ]; then \
		echo "Making directory $*"; \
		mkdir -p $* ; \
	fi;
