APP_TARGET    = app10e
LIB_SRC       = app10e.c

# ERTS (activity / time libraries)
ERTS_LIB_DIR         = ../../lib
ERTS_INCLUDE_DIR     = ../../lib
ERTS_LIBs            = -lcommunication

# Message libraries
IDL_INCLUDE_DIR     = ../../msg/include
IDL_LIB_DIR         = ../../msg/lib
IDL_LIBs            = -lthread_msgs

# System libs for ftrace markers
C_POSIX_LIBS = ../../../lib/activity_library.a ../../../lib/time_library.a ../../../lib/trace_marker.a

CPPFLAGS = -c -Wall -fpic -m64 -O2 -std=c++17 -I../../../lib -I../.. -I.
LDFLAGS  = -m64

CPP = g++
LN  = g++

SYSLIBS = -ldl -lm -lpthread -lrt

INCLUDES = -I. -I$(ERTS_INCLUDE_DIR) -I$(IDL_INCLUDE_DIR) -I../../../lib

Static_LIBS = -L$(IDL_LIB_DIR)/ $(IDL_LIBs) -L$(ERTS_LIB_DIR)/ $(ERTS_LIBs)

DDS_LIBS = -lfastcdr \
           -L/home/leonardo/Fast-DDS-3.2.2/build/src/cpp \
           -L/home/leonardo/Fast-CDR-2.2.0/build/src/cpp \
           -Wl,-rpath=/home/leonardo/Fast-DDS-3.2.2/build/src/cpp \
           -Wl,-rpath=/home/leonardo/Fast-CDR-2.2.0/build/src/cpp \
           -lfastdds

DIRECTORIES = output.dir

all: $(DIRECTORIES) $(APP_TARGET) clean
	@echo "=============================================="
	@echo "  app10e compilato con successo!"
	@echo "  Per usarlo:"
	@echo "    1. cd .../ThreadAnalysisDDS && make -f ThreadAnalysisDDS_makefile"
	@echo "    2. ./ThreadAnalysisDDS   (terminale 1)"
	@echo "    3. ./app10e              (terminale 2)"
	@echo "=============================================="

APP_OBJS = output/app10e.o

$(APP_TARGET): $(APP_OBJS)
	$(LN) $(LDFLAGS) -o $@ $(APP_OBJS) $(C_POSIX_LIBS) -Wl,-Bstatic $(Static_LIBS) -Wl,-Bdynamic $(DDS_LIBS) $(SYSLIBS)

output/%.o:%.c
	$(CPP) $(CPPFLAGS) $(INCLUDES) $(DEFINES) -c $< -o $@

output/%.o:%.cpp
	$(CPP) $(CPPFLAGS) $(INCLUDES) $(DEFINES) -c $< -o $@

.PHONY: $(APP_TARGET)

clean:
	@rm -rf output

%.dir :
	@echo "Checking directory $*"
	@if [ ! -d $* ]; then \
		echo "Making directory $*"; \
		mkdir -p $* ; \
	fi;
