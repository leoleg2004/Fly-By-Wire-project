\contentsline {figure}{\numberline {10.1}{\ignorespaces \relax }}{92}{figure.caption.280}%
\contentsline {figure}{\numberline {10.2}{\ignorespaces Risposta del sistema con $Q \gg R$. (a) Il rientro è immediato e aggressivo,(b) ma genera picchi di comando che possono causare la saturazione degli attuatori.}}{94}{figure.caption.287}%
\contentsline {figure}{\numberline {10.3}{\ignorespaces Analisi geometrica con $Q \gg R$. La ripidezza della funzione di Lyapunov (b) forza le traiettorie di fase (a) a una convergenza dalle condizioni inziali verso l'equilibrio.}}{95}{figure.caption.288}%
\contentsline {figure}{\numberline {10.4}{\ignorespaces Risposta del sistema con $Q \approx R$. El controllore offre un ottimo compromesso tra rapidità di reiezione del disturbo (a) e contenimento dello sforzo di controllo (b).}}{96}{figure.caption.290}%
\contentsline {figure}{\numberline {10.5}{\ignorespaces Analisi geometrica con $Q \approx R$. La conformazione bilanciata della superficie di Lyapunov (b) garantisce traiettorie di fase (a) fluide e ben smorzate verso l'origine.}}{97}{figure.caption.291}%
\contentsline {figure}{\numberline {10.6}{\ignorespaces Risposta del sistema con $R \gg Q$. L'azione di controllo è moderata ed energeticamente efficiente (b), ma il rientro al punto operativo risulta molto più lento (a).}}{98}{figure.caption.293}%
\contentsline {figure}{\numberline {10.7}{\ignorespaces Analisi geometrica con $R \gg Q$. La superficie di Lyapunov risulta quasi piatta (b), permettendo alle traiettorie di fase (a) ampie escursioni e una convergenza molto lenta.}}{98}{figure.caption.294}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {11.1}{\ignorespaces Evoluzione spaziale degli insiemi a $i$ passi. Il grafico confronta visivamente le proprietà matematiche discusse mostrando un target invariante (insiemi stabilizzabili $\mathcal {S}_i$) si ottiene una sequenza in rigorosa espansione monotona, mentre l'utilizzo di un target generico non invariante (insiemi controllabili $\mathcal {C}_i$) non garantisce la proprietà che garantisce la completa controllabilità del sistema in N passi}}{111}{figure.caption.356}%
\contentsline {figure}{\numberline {11.2}{\ignorespaces Rappresentazione del poliedro di invarianza $\mathcal {X}_f$ (fetta $\theta =0$) e traiettoria di predizione dello stato verso l'origine.}}{112}{figure.caption.360}%
\contentsline {figure}{\numberline {11.3}{\ignorespaces Evoluzione temporale delle variabili di stato: beccheggio, pitch rate e variazioni di velocità lineare.}}{113}{figure.caption.361}%
\contentsline {figure}{\numberline {11.4}{\ignorespaces Sforzo di controllo degli attuatori: si noti l'attivazione dei vincoli di saturazione sull'elevatore e sui flap.}}{114}{figure.caption.362}%
\contentsline {figure}{\numberline {11.5}{\ignorespaces Analisi geometrica del controllore MPC a ciclo chiuso. Il grafico tridimensionale mostra l'evoluzione dello stato e il corrispondente andamento decrescente del funzionale di costo ottimo, che si comporta come una funzione di Lyapunov scendendo lungo la superficie del costo terminale.}}{115}{figure.caption.364}%
