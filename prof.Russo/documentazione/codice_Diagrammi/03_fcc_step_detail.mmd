flowchart TD
    StepStart([FCC.step chiamato]) --> ClampDt["Clamp dt a 0.001 - 0.05 s"]
    ClampDt --> SnapLock["Lock mutex\nsnap = m_state"]
    SnapLock --> UpdateSystem["snap.system_active = engines_on\nsnap.landing_mode  = landing_mode"]
    UpdateSystem --> ControlLaw["m_law.compute()\nRitorna: ControlSurfaces cmd"]
    ControlLaw --> UpdateMode["snap.mode        = evaluate_mode\nsnap.protections = protection_status"]
    UpdateMode --> ActuatorDyn["update_actuators( cmd, dt )\nModello primo ordine con rate limit\nm_actuator aggiornato"]
    ActuatorDyn --> ISA["Atmosfera ISA\nT e rho calcolati dalla quota"]
    ISA --> VelAero["V_T = sqrt( u^2 + v^2 + w^2 )\nalpha = atan2( w, u )\nbeta  = asin( v / V_T )"]
    VelAero --> Qbar["q_bar = 0.5 * rho * V_T^2"]
    Qbar --> Thrust["Se system_active e engine_ready:\n  T = T_min + thr * T_max - T_min\nAltrimenti: T = 0"]
    Thrust --> AeroFM["F16AeroFM\n44 lookup table NASA TP-1538\nRitorna: Fx Fy Fz  L M N"]
    AeroFM --> Gravity["Gravita nel body frame\nWx Wy Wz da phi e theta"]
    Gravity --> RK4Start["Setup RK4\ndenom = Ixx*Izz - Ixz^2"]
    RK4Start --> K1["k1 = compute_accel( u v w p q r )"]
    K1 --> K2["k2 = compute_accel( stato + k1 * dt/2 )"]
    K2 --> K3["k3 = compute_accel( stato + k2 * dt/2 )"]
    K3 --> K4["k4 = compute_accel( stato + k3 * dt )"]
    K4 --> Integrate["Integrazione RK4\nu v w p q r += dt * k1+2k2+2k3+k4 / 6"]
    Integrate --> EulerRates["Cinematica Eulero\nPhi_dot Theta_dot Psi_dot\nda p q r"]
    EulerRates --> UpdateEuler["Aggiorna phi theta psi\nWrap e clamp angoli"]
    UpdateEuler --> BodyToEarth["Trasformazione DCM body to earth\nCalcola x_dot y_dot z_dot"]
    BodyToEarth --> UpdatePos["Aggiorna z Nord\nAggiorna x Est\nAggiorna altitude"]
    UpdatePos --> GroundClamp{"altitude\nminore o uguale a 0?"}
    GroundClamp -->|Si| Ground["Ground clamp\naltitude = 0\nDamping su phi e theta"]
    GroundClamp -->|No| NumSafety["Check isfinite\nsu u v w p q r"]
    Ground --> NumSafety
    NumSafety --> EICAS{"Status\nmessage"}
    EICAS -->|landing_mode| LandMsg["ILS LANDING MODE ACTIVE"]
    EICAS -->|motori spenti| EngMsg["ENGINES SHUT DOWN"]
    EICAS -->|alpha floor| StallMsg["STALL WARNING - HIGH ALPHA"]
    EICAS -->|normale| NormMsg["NORMAL FLIGHT 6-DOF F-16"]
    LandMsg --> IncrPkt["packet_id++"]
    EngMsg --> IncrPkt
    StallMsg --> IncrPkt
    NormMsg --> IncrPkt
    IncrPkt --> UnlockStore["Unlock mutex\nm_state = snap"]
    UnlockStore --> StepEnd([Fine physics step])
