flowchart TD
    Start([Pilot Node: Render Loop Inizia 60Hz]) --> Fase1
    
    subgraph Fase1[Fase 1: Acquisizione Input FlightDisplay::HandleInput]
        A[Lettura Tastiera/Asse Joystick:<br>KEY_UP/DOWN -> stick_pitch<br>KEY_LEFT/RIGHT -> stick_roll<br>W/S/SPACE -> speed_delta]
        B[Acquisizione Toggle Motori/Carrello/ILS]
        C[Aggiornamento Spaziale Audio e VWS Alarms]
        D[Aggiornamento Animazioni Modello]
        A --> B --> C --> D
    end
    
    Fase1 --> Passaggio[Passaggio Struttura PilotInput al FCC] --> Fase2
    
    subgraph Fase2[Fase 2: Flight Control Law FCC::step]
        E(ControlLaw::evaluate_mode)
        F{Sistema Attivo?}
        G[FBWMode::DIRECT_LAW<br>Generazione ControlSurfaces grezze]
        H[FBWMode::NORMAL_LAW<br>Generazione ControlSurfaces C-Star Law<br>roll_rate_demand = stick_roll * 1.5 rad/s<br>pitch_rate_demand = stick_pitch * 0.5 rad/s]
        I[ControlLaw::apply_protections<br>Calcola bool_alpha_floor, overspeed, ecc.]
        J[Clamp Meccanico Strutturale Attuatori<br>±25° ali, ±30° code]
        
        E --> F
        F -- No --> G
        F -- Sì --> H
        G --> I
        H --> I
        I --> J
    end
    
    Fase2 --> Fase3
    
    subgraph Fase3[Fase 3: Attuazione Dinamica FCC::step]
        K[Integrazione Base Assetto<br>snap.roll_rate = aileron * 0.06<br>snap.pitch_rate = elevator * 0.04]
        L{Autopilota di Emergenza?}
        
        M{Quale?}
        N[Terrain Pull Up:<br>Pitch +3.0 rad/s<br>Boost Altitudine]
        O[Overshoot Pull Down:<br>Pitch -3.0 rad/s<br>Livellamento Ali]
        P[Critical Bank:<br>Roll -3.0 rad/s restitutivo<br>Stabilizzazione Pitch]
        Q[Mantenimento ratei piloti]
        
        R[Integrazione Finale Ratei -> Angoli Eulero<br>Virata Coordinata Naturale]
        S[Risoluzione Spinta Motori<br>Traslazione X, Z, Speed, Altitude]
        T[Gestione Collisione Suolo Altitude = 0]
        
        K --> L
        L -- Sì --> M
        M -- "Alt < 300m" --> N
        M -- "Alt > 15000m" --> O
        M -- "|Roll| > 1.0" --> P
        L -- No --> Q
        
        N --> R
        O --> R
        P --> R
        Q --> R
        
        R --> S --> T
    end
    
    Fase3 --> Fase4
    
    subgraph Fase4[Fase 4: Rendering FlightDisplay::Draw]
        U[Aggiornamento status_msg EICAS Alarms]
        V[Esportazione FlightState Aggiornato]
        W[Copia in PlaneData C-Style]
        X[Aggiornamento Telecamera<br>no interpolation]
        Y[Visualizzazione Mesh F35 & Effetti Afterburner]
        Z[Disegno HUD Horizon, Altimeter, Tapes]
        
        U --> V --> W --> X --> Y --> Z
    end
    
    Fase4 --> Finish([Fine Rendering Frame])
