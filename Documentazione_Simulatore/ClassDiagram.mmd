    %% Relazioni e Molteplicità
    FlightControlLaw ..> ControlSurfaces : creates
    FlightControlLaw ..> ProtectionStatus : uses
    FlightControlLaw ..> PilotInput : uses
    FlightControlLaw ..> FlightState : uses

    FlightControlComputer *-- FlightControlLaw : m_law
    FlightControlComputer o-- FlightState : m_state

    FlightDisplay ..> PlaneData : reads
    FlightDisplay ..> PilotInput : produces

    MonitorDisplay ..> PlaneData : reads

    %% DDS Core Relations
    DomainParticipantFactory ..> DomainParticipant : creates
    DomainParticipant *-- Publisher : owns
    DomainParticipant *-- Subscriber : owns
    DomainParticipant *-- Topic : owns

    Publisher *-- DataWriter : owns
    Subscriber *-- DataReader : owns

    DataWriter --> Topic : publishes to
    DataReader --> Topic : subscribes to

    TypeSupport *-- TopicDataType : wraps
    TopicDataType <|-- SystemStatsPubSubType

    %% DDS Telemetry eIDL Relations
    DataReaderListener <|-- DashboardListener
    DashboardListener ..> DataReader : reads from
    DashboardListener ..> SystemStats : deserializes into
    DashboardListener ..> PlaneData : updates shared_aereo
    SystemStatsPubSubType ..> SystemStats : serializes/deserializes
